# --- planning / private notes -------------------------------------------------
# The whole docs/ tree is intentionally untracked (product notes, positioning,
# API feedback log). If you ever want to publish the Rain feedback artifact,
# add `!docs/FEEDBACK.md` below.
docs/

# --- secrets ------------------------------------------------------------------
.env
.env.*
!.env.example

# Every .pem is ignored by default. The ONLY exception is `keys/*.pub.pem`,
# which by construction can hold nothing but public keys. See keys/README.md.
*.pem
!keys/*.pub.pem

