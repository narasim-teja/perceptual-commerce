{
  "name": "tessr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The perception layer for agentic commerce: perceive a real-world condition, gate it fail-closed onchain, spend inside bounds.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narasim-teja/tessr.git"
  },
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "postinstall": "bun run contract:deps",
    "contract:deps": "test -d packages/policy/contract/lib/forge-std || (git clone --depth 1 -q https://github.com/foundry-rs/forge-std packages/policy/contract/lib/forge-std && rm -rf packages/policy/contract/lib/forge-std/.git packages/policy/contract/lib/forge-std/lib)",
    "contract:build": "forge build --root packages/policy/contract",
    "contract:test": "forge test --root packages/policy/contract -vv",
    "contract:fmt": "forge fmt --root packages/policy/contract",
    "policy:balance": "bun run scripts/policy.ts balance",
    "policy:deploy:dry": "bun run scripts/policy.ts deploy --dry",
    "policy:deploy": "bun run scripts/policy.ts deploy",
    "policy:state": "bun run scripts/policy.ts state",
    "route:list": "bun run scripts/payment-route.ts list",
    "route:create": "bun run scripts/payment-route.ts create",
    "web": "bun run --cwd frontend dev",
    "demo": "bun run packages/app/src/restock.ts",
    "example": "bun run examples/quickstart.ts"
  },
  "dependencies": {
    "@tessr/core": "workspace:*",
    "@tessr/perception": "workspace:*",
    "@tessr/policy": "workspace:*",
    "@tessr/settlement": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "viem": "^2.40.2",
    "zod": "^4.1.13"
  }
}
