# Copy to `.env` (git-ignored). Bun loads it for every script in this repo.
# NOTHING here is a real-funds credential. Sandbox + testnet only.
#
# Read top to bottom: the first setting decides whether you need the second block.

# ─── Which rail the loop settles on ───────────────────────────────────────────
# Cards are the only settlement rail. This picks whether the cards are real.
#
#   fake  the whole loop runs against an in-process Rain server. No network, no
#         credentials, no cards created. Every stage still emits, the contract is
#         still read and ruled on, and a receipt still comes back. The RAIN_*
#         block below can stay empty.
#   rain  mints a real scoped card in the Rain sandbox. Needs the RAIN_* values
#         and the sandbox public key below.
#
# Nothing downstream can tell the two apart: same observation, same ruling, same
# receipt shape. That is why `fake` is the default, and why it is the one to demo
# from when the venue wifi is bad.
#
# At `rain`, the card is really minted and the authorization really runs at Rain.
# The purchase is driven through Rain's own simulate endpoints, because there is
# no merchant terminal in the room, and a sandbox has no other way to be spent
# against.
RAIL=fake

# ─── Rain sandbox (only needed when RAIL=rain) ────────────────────────────────
# Provisioned per team at the hackathon.
RAIN_API_KEY=
RAIN_USER_ID=                 # uuid — the cardholder; path param on card creation
RAIN_TEAM_ID=                 # uuid — scopes some endpoints
RAIN_CONTRACT_ID=             # uuid — collateral contract, used by /simulate/collateral/fund
RAIN_BASE_URL=https://api-dev.raincards.xyz/v1
# The one immutable payment route the funding beat pushes simulated dollars
# down (usd/ach in, usdc out on Base Sepolia). Created ONCE by
# `bun run spikes/07-payment-route.ts --confirm --address 0x…`; put the printed
# id here. RAIL=fake builds its own route and ignores this.
RAIN_PAYMENT_ROUTE_ID=

# Rain's sandbox RSA public key, from /docs/resource-sessionid-keys.
# Multi-line PEM: keep it on ONE line with literal \n escapes, or point at a file below.
RAIN_SANDBOX_RSA_PUBKEY_PEM=
# Alternative to the inline PEM — path to a .pem file on disk (takes precedence if set).
RAIN_SANDBOX_RSA_PUBKEY_FILE=./keys/rain-sandbox.pub.pem   # public key, committed - see keys/README.md

# ─── Monad (the policy plane) ─────────────────────────────────────────────────
# The contract is the mint authority: it rules on whether a card may be created
# at all. Reads are free and always run; the kill switch and the payee allowlist
# are real writes and cost testnet gas.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
POLICY_CONTRACT_ADDRESS=
# Throwaway testnet key ONLY. Never a key that holds real value.
DEPLOYER_PRIVATE_KEY=
# The agent's own key, optional. The split is the story: the agent's key may
# only ASK the gate (it signs `ruleMint` and nothing else), while the owner's
# key MOVES the gate (kill switch, allowlist, limits). Unset, rulings fall back
# to the deployer key. Needs its own testnet gas if set.
AGENT_PRIVATE_KEY=
# Write denied rulings on chain too. Off by default: the free read already
# refuses, and a deny that costs gas on every stray intent is a griefing
# vector. On, every refusal emits MintRuling and the record links its tx.
RECORD_DENIES=false

# ─── Perception ───────────────────────────────────────────────────────────────
# This half runs in the browser, holds no key and has no path to settlement. It
# can compute a number and post an observation; nothing here can spend.
#
# Where the frames come from:
#   camera     opens a webcam and watches a fixed region of the frame.
#   simulated  drives the identical sampler from an authored scene, so the loop
#              can be exercised with no camera and no shelf.
# Nothing downstream can tell the two apart; this selects the source, never the
# spine. The panel has its own on/off switch, so `camera` here is the default the
# page opens with rather than a commitment.
PERCEPTION_MODE=simulated
#
# What turns the watched region into a reading. All four emit the identical
# observation, so this also selects the source and never the spine.
#   screen      region vs a reference frame. No model, no download, no network.
#               Measures how much changed, so it cannot count and says so.
#   objects     Xenova/yolos-tiny, 9 MB. Counts one of COCO's 80 classes.
#   objects-hd  onnx-community/rfdetr_nano-ONNX, 29 MB. The same COCO classes,
#               read by RF-DETR: a stronger detector for a crowded shelf, at
#               three times the download.
#   open-vocab  Xenova/owlvit-base-patch32, 148 MB. Counts any phrase you type.
# Weights come from the Hugging Face CDN on first load and the browser caches
# them. Warm the cache before you are on stage, not on conference wifi.
#
# For the bottle demo: PERCEPTION_MODE=camera with PERCEPTION_DETECTOR=objects.
# `bottle` is a COCO class, so that pair counts drink bottles at 9 MB. Cans and
# tins are not COCO classes and need open-vocab's 148 MB download.
PERCEPTION_DETECTOR=screen
# What the model detectors count. A COCO class for `objects`, any phrase for
# `open-vocab`. Also the subject the signal names: `bottle` reads `bottle.stock < 3`.
PERCEPTION_TARGET=bottle
# Instances at or below this read as low stock.
PERCEPTION_LOW_AT=3
# `screen` only: fraction of the region that must diverge from its reference to fire.
PERCEPTION_THRESHOLD=0.32

# ─── Demo knobs ───────────────────────────────────────────────────────────────
DEMO_MCC=5411                 # 5411 = grocery stores / supermarkets (the restock supplier)
DEMO_WRONG_MCC=5813           # 5813 = bars/nightclubs — used to demo the MCC decline
DEMO_MERCHANT_NAME=Restaurant Depot
DEMO_AMOUNT_USD_CENTS=4299    # keep small; sandbox allows only $5,000 approved spend / 24h

# ─── Standalone scripts ───────────────────────────────────────────────────────
# The app never reads this. The loop mints its own card on every run, so nothing
# here needs setting to demo. It exists so the one-off Rain scripts under
# `spikes/` can transact against a card that already exists instead of minting
# another one.
DEMO_CARD_ID=
# Spike 07 only: the on-chain destination for the payment route it creates.
# `--address 0x…` on the command line wins over this.
RAIN_FUND_DESTINATION_ADDRESS=
